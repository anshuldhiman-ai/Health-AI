{
  "name": "trading-journal-server",
  "version": "0.1.0",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "node --watch index.js",
    "start": "node index.js",
    "prisma:generate": "prisma generate --schema db/schema.prisma",
    "prisma:migrate": "prisma migrate dev --name init --schema db/schema.prisma",
    "prisma:deploy": "prisma migrate deploy --schema db/schema.prisma",
    "postinstall": "prisma generate --schema db/schema.prisma"
  },
  "prisma": {
    "schema": "db/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "multer": "^1.4.5-lts.1",
    "papaparse": "^5.4.1",
    "pdf-parse": "^1.1.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  }
}
